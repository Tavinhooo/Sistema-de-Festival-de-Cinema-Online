@page
@{
    ViewData["Title"] = "A ver filme";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ProjetoES</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/cinema.css" />
</head>
<body>

    <header class="cinema-topbar">
        <a href="/Perfil" class="btn-back">
            <i class="fas fa-arrow-left"></i> Voltar aos Meus Acessos
        </a>
        
        <div style="color: #666; font-size: 14px;">
            <i class="fas fa-shield-alt"></i> Ligação Segura
        </div>
    </header>

    <main class="player-wrapper">
        <div class="video-container">
            <div class="video-placeholder">
                <i class="fas fa-play-circle play-button" title="Iniciar Filme"></i>
            </div>
            
            <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 5px; background: rgba(255,255,255,0.2);">
                <div style="width: 30%; height: 100%; background: #c47cb8;"></div>
            </div>
        </div>
    </main>

    <section class="movie-details">
        <div class="movie-title-area">
            <h1>Batman: O Início</h1>
            <div class="movie-meta">
                <span>Festival da Batata Doce</span>
                <span>•</span>
                <span>2005</span>
                <span>•</span>
                <span>2h 20min</span>
                <span class="badge-age">M/12</span>
            </div>
        </div>

        <div>
            <button class="btn-rate">
                <i class="far fa-star"></i> Avaliar Filme
            </button>
        </div>
    </section>

</body>
</html>