@page
@model ProjetoES.Pages.Admin.ListarFilmesModel
@{
    ViewData["Title"] = "Gestão - Catálogo de Filmes";
}

<div class="admin-page-wrapper">
    <div class="admin-container" style="max-width: 1000px;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e5d8fb; padding-bottom: 12px; margin-bottom: 30px;">
            <h2 class="admin-title" style="border: none; padding: 0; margin: 0;">Catálogo de Filmes</h2>
            <a href="/Admin/AdicionarFilme" class="btn-submit" style="width: auto; margin-top: 0; padding: 10px 20px; text-decoration: none;">+ Novo Filme</a>
        </div>

        @if (!Model.Filmes.Any())
        {
            <div style="text-align: center; padding: 40px; background-color: #f8f9fa; border-radius: 8px;">
                <h3 style="color: #666;">Ainda não existem filmes no sistema.</h3>
                <p style="color: #999;">Clica no botão "+ Novo Filme" para começares a construir o teu catálogo.</p>
            </div>
        }
        else
        {
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #f4f0fc; text-align: left;">
                        <th style="padding: 15px; color: #444; border-radius: 8px 0 0 0;">Título</th>
                        <th style="padding: 15px; color: #444;">Género</th>
                        <th style="padding: 15px; color: #444;">Ano</th>
                        <th style="padding: 15px; color: #444;">Duração</th>
                        <th style="padding: 15px; color: #444;">Preço</th>
                        <th style="padding: 15px; color: #444; text-align: center; border-radius: 0 8px 0 0;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var filme in Model.Filmes)
                    {
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 15px; font-weight: 600; color: #2c3e50;">@filme.Titulo</td>
                            <td style="padding: 15px; color: #666;">@filme.Genero</td>
                            <td style="padding: 15px; color: #666;">@filme.Ano</td>
                            <td style="padding: 15px; color: #666;">@filme.DuracaoMinutos min</td>
                            <td style="padding: 15px; font-weight: 600; color: #6b439b;">@filme.PrecoBilhete.ToString("0.00")€</td>
                            <td style="padding: 15px; text-align: center; display: flex; gap: 10px; justify-content: center;">
                                <a href="/Admin/EditarFilme?id=@filme.Id" style="text-decoration: none; color: #1976d2; font-weight: 600; font-size: 13px;">Editar</a>
    
                                <form method="post" asp-page-handler="Eliminar" asp-route-id="@filme.Id" onsubmit="return confirm('Tens a certeza?')">
                                    <button type="submit" style="background: none; border: none; color: #e53935; cursor: pointer; font-weight: 600; font-size: 13px;">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>