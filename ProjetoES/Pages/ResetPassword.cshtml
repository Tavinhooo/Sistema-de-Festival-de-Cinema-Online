@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nova Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-page-wrapper">
        <div class="form-section">
            <div class="form-wrapper">

                <h1>Criar Nova Password</h1>
                <p class="subtitle" style="margin-bottom: 30px;">A tua nova password deve ser diferente da antiga e conter pelo menos 8 caracteres e um símbolo especial.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" style="color: #e53935; font-size: 13px; margin-bottom: 15px; font-weight: 600;"></div>

                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div class="input-group">
                        <div class="label-row">
                            <label asp-for="Input.Password">Nova Password</label>
                        </div>
                        <input asp-for="Input.Password" type="password" placeholder="Introduz a nova password" required>
                        <span asp-validation-for="Input.Password" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                    </div>

                    <div class="input-group" style="margin-bottom: 30px;">
                        <div class="label-row">
                            <label asp-for="Input.ConfirmarPassword">Confirmar Nova Password</label>
                        </div>
                        <input asp-for="Input.ConfirmarPassword" type="password" placeholder="Repete a password" required>
                        <span asp-validation-for="Input.ConfirmarPassword" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                    </div>

                    <button type="submit" class="btn-login">Guardar Password</button>
                </form>

            </div>
        </div>

        <div class="image-section">
            <svg class="svg-waves" viewBox="0 0 600 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
                        <feDropShadow dx="-12" dy="5" stdDeviation="10" flood-color="#000000" flood-opacity="0.15"/>
                    </filter>
                </defs>
                <rect width="100%" height="100%" fill="#d2bdf5" />
                <path d="M 250,0 C 350,300 150,600 350,1000 L 600,1000 L 600,0 Z" fill="#bca1ef" filter="url(#shadow)" />
                <path d="M 350,0 C 200,250 450,700 450,1000 L 600,1000 L 600,0 Z" fill="#cfb6f6" filter="url(#shadow)" />
                <path d="M 500,0 C 400,350 600,650 550,1000 L 600,1000 L 600,0 Z" fill="#e5d8fb" filter="url(#shadow)" />
            </svg>
        </div>
    </div>
</body>
</html>