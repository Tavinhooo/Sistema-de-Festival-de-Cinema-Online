@page
@{
    ViewData["Title"] = "Login";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <div class="login-page-wrapper">
        
        <div class="form-section">
            <div class="form-wrapper">
                
                <h1>Bem Vindo!</h1>
                <p class="subtitle">Insira as credenciais da sua conta</p>
                <div id="login-message" style="display:none; margin-bottom:16px; padding:12px 14px; border-radius:10px; font-size:0.95rem;"></div>

                <form id="login-form" action="#" method="POST" novalidate>
                    
                    <div class="input-group">
                        <div class="label-row">
                            <label for="email">Email</label>
                        </div>
                        <input type="email" id="email" name="email" placeholder="Insira o seu email" required>
                    </div>

                    <div class="input-group">
                        <div class="label-row">
                            <label for="password">Password</label>
                            <a href="#" class="forgot-password">forgot password</a>
                        </div>
                        <input type="password" id="password" name="password" placeholder="Senha" required>
                    </div>

                    <div class="checkbox-row">
                        <input type="checkbox" id="remember" name="remember">
                        <label for="remember">Lembre-se por 30 dias.</label>
                    </div>

                    <button type="submit" class="btn-login">Login</button>

                </form>

                <div class="google-btn-wrapper">
                    <button class="btn-google">
                        <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Sign in with Google
                    </button>
                </div>

                <p class="register-link">
                    Não tem conta? <a href="/Register">Registe-se</a>
                </p>

            </div>
        </div>

        <div class="image-section">
            <svg class="svg-waves" viewBox="0 0 600 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
                        <feDropShadow dx="-12" dy="5" stdDeviation="10" flood-color="#000000" flood-opacity="0.15"/>
                    </filter>
                </defs>
                
                <rect width="100%" height="100%" fill="#d2bdf5" />
                
                <path d="M 250,0 C 350,300 150,600 350,1000 L 600,1000 L 600,0 Z" fill="#bca1ef" filter="url(#shadow)" />
                
                <path d="M 350,0 C 200,250 450,700 450,1000 L 600,1000 L 600,0 Z" fill="#cfb6f6" filter="url(#shadow)" />
                
                <path d="M 500,0 C 400,350 600,650 550,1000 L 600,1000 L 600,0 Z" fill="#e5d8fb" filter="url(#shadow)" />
            </svg>
        </div>

    </div>

    <script src="~/js/api-client.js"></script>
    <script>
        const loginForm = document.getElementById('login-form');
        const loginMessage = document.getElementById('login-message');

        function showLoginMessage(text, isError) {
            loginMessage.textContent = text;
            loginMessage.style.display = 'block';
            loginMessage.style.background = isError ? '#ffe8e8' : '#e7f7ec';
            loginMessage.style.color = isError ? '#8a1f1f' : '#135c2a';
            loginMessage.style.border = isError ? '1px solid #f2b8b8' : '1px solid #b7e1c1';
        }

        loginForm.addEventListener('submit', async function (event) {
            event.preventDefault();

            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const remember = document.getElementById('remember').checked;

            try {
                const response = await ApiClient.login(email, password);
                const token = response.token || response.Token;

                if (!token) {
                    throw new Error('Resposta de login não contém token.');
                }

                ApiClient.setToken(token, remember);
                showLoginMessage('Login concluído. A redirecionar...', false);
                setTimeout(() => window.location.href = '/', 1000);
            } catch (error) {
                showLoginMessage(error.message || 'Erro ao iniciar sessão.', true);
            }
        });
    </script>

</body>
</html>