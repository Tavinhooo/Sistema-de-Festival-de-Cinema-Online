@page
@{
    ViewData["Title"] = "Detalhes do Filme";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/filme.css" />
</head>
<body>

    <header class="navbar">
        <div class="logo">
            <i class="fa-brands fa-figma"></i>
        </div>
        <div class="search-container">
            <input type="text" placeholder="Pesquisa Geral">
            <i class="fas fa-search"></i>
        </div>
        <div class="nav-actions">
            <i class="fas fa-shopping-cart cart-icon"></i>
            <button class="btn btn-signin">Sign in</button>
            <button class="btn btn-register">Register</button>
        </div>
    </header>

    <main class="main-content">
        
        <div class="movie-hero">
            
            <div class="movie-info-col">
                <div class="movie-header">
                    <div class="movie-poster">
                        <div class="shapes-placeholder">
                            <div style="width: 100%; display:flex; justify-content:center;">
                                <div class="shape-triangle"></div>
                            </div>
                            <div class="shape shape-star"></div>
                            <div class="shape shape-square"></div>
                        </div>
                    </div>
                    <div class="movie-details">
                        <h1>Título do Filme</h1>
                        <p>8.1 (Rating)</p>
                        <p>Gêneros do Filme</p>
                        <p>2026 &nbsp;&nbsp; 2h:12min &nbsp;&nbsp; +16</p>
                    </div>
                </div>

                <div class="movie-buttons">
                    <button class="btn-pill">Sinopse</button>
                    <button class="btn-pill">Elenco e Realizador</button>
                    <button class="btn-add-cart">Adicionar ao carrinho</button>
                </div>
            </div>

            <div class="movie-trailer-col">
                <h2 class="trailer-title">Trailer:</h2>
                <div class="trailer-box">
                    <i class="far fa-play-circle"></i>
                </div>
                
                <div class="trailer-actions">
                    <div class="action-item">
                        <i class="fas fa-plus-circle"></i> Ver Depois
                    </div>
                    <div class="action-item">
                        <i class="far fa-star"></i> Avaliar
                    </div>
                    <div class="action-item">
                        <i class="far fa-eye"></i> Visto
                    </div>
                </div>
            </div>
            
        </div>

        <div>
            <div class="section-badge">Relacionados</div>
            <div class="card-row">
                @for (int i = 0; i < 5; i++)
                {
                    <div class="card">
                        <div class="shapes-placeholder">
                            <div style="width: 100%; display:flex; justify-content:center;">
                                <div class="shape-triangle"></div>
                            </div>
                            <div class="shape shape-star"></div>
                            <div class="shape shape-square"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="section-badge">Avaliações</div>
            <div class="reviews-row">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <span>John Jones</span>
                            <i class="far fa-star"></i> 9
                        </div>
                        <div class="review-body">
                            Comentario:
                        </div>
                    </div>
                }
            </div>
        </div>

    </main>

</body>
</html>