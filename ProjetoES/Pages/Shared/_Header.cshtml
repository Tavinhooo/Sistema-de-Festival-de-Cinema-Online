<header class="navbar">
    <a asp-page="/Index" class="logo" aria-label="Ir para a página inicial">
        <img src="~/images/logo.png" alt="Logo do festival" style="width: 200px; height: 77px; object-fit: contain; display: block;" />
    </a>
    
    <div class="search-container">
        <input type="text" placeholder="Pesquisa Geral">
        <i class="fas fa-search"></i>
    </div>

    <div class="nav-actions" id="navActions">
        <a asp-page="/Carrinho" class="cart-link" aria-label="Abrir carrinho">
            <i class="fas fa-shopping-cart cart-icon"></i>
        </a>
        <a class="btn btn-signin" asp-page="/Login">Sign in</a>
        <a class="btn btn-register" asp-page="/Register">Register</a>
    </div>
</header>
