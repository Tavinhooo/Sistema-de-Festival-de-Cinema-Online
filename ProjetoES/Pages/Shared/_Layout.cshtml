<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjetoES.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/filmes.css" />
</head>
<body>
    <header class="navbar">
        <a asp-page="/Index" class="logo" aria-label="Ir para a página inicial">
            <img src="~/images/logo.png" alt="Logo do festival" style="width: 200px; height: 77px; object-fit: contain; display: block;" />
        </a>
        
        <div class="search-container">
            <input type="text" placeholder="Pesquisa Geral">
            <i class="fas fa-search"></i>
        </div>

        <div class="nav-actions" id="navActions">
            <a asp-page="/Carrinho" class="cart-link" aria-label="Abrir carrinho">
                <i class="fas fa-shopping-cart cart-icon"></i>
            </a>
            <a class="btn btn-signin" asp-page="/Login">Sign in</a>
            <a class="btn btn-register" asp-page="/Register">Register</a>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ProjetoES - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof ApiClient !== 'undefined' && ApiClient.renderAuthNavigation) {
            ApiClient.renderAuthNavigation('navActions');
        }
    });
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
