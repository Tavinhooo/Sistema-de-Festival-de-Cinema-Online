<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="navbar">
        <div class="logo">
            <a href="/" style="color: inherit; text-decoration: none;">
                <i class="fa-brands fa-figma"></i> ProjetoES
            </a>
        </div>
        
        <div class="search-container">
            <input type="text" placeholder="Pesquisa Geral">
            <i class="fas fa-search"></i>
        </div>

        <div class="nav-actions">
            <a asp-page="/Carrinho" style="color: inherit;">
                <i class="fas fa-shopping-cart cart-icon"></i>
            </a>

            @if (User.Identity is { IsAuthenticated: true })
            {
                <details class="profile-dropdown">
                    <summary class="profile-trigger">
                        <span class="profile-avatar"><i class="fas fa-user"></i></span>
                        <span class="profile-meta">
                            <span class="profile-name">@User.Identity.Name</span>
                            <span class="profile-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </span>
                    </summary>
                    <div class="profile-menu">
                        <a asp-page="/Perfil">O Meu Perfil</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-page="/Admin/Dashboard">Painel Admin</a>
                        }
                        <form method="post" asp-page="/Index" asp-page-handler="Logout">
                            <button type="submit">Sair (Logout)</button>
                        </form>
                    </div>
                </details>
            }
            else
            {
                <a class="btn btn-signin" asp-page="/Login">Sign in</a>
                <a class="btn btn-register" asp-page="/Register">Register</a>
            }
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>