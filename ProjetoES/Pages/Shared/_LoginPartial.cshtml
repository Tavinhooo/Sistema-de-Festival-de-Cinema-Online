@using Microsoft.AspNetCore.Identity
@using ProjetoES.Models

<ul class="navbar-nav">
    @if (User.Identity is { IsAuthenticated: true })
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar-container me-2">
                    <img src="~/images/default-avatar.png" alt="Avatar" class="rounded-circle" style="width: 35px; height: 35px; object-fit: cover; border: 2px solid #fff;">
                </div>
                <div class="user-info text-start">
                    <span class="d-block fw-bold" style="font-size: 0.9rem; line-height: 1;">@User.Identity.Name</span>
                    <small class="text-muted" style="font-size: 0.75rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" asp-page="/Perfil">Meu Perfil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" asp-page="/Index" asp-page-handler="Logout">
                        <button type="submit" class="dropdown-item text-danger">Terminar Sessão</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn btn-outline-primary me-2" asp-page="/Login">Sign In</a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn btn-primary text-white" asp-page="/Register">Register</a>
        </li>
    }
</ul>