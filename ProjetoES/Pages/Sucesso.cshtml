@page
@{
    ViewData["Title"] = "Compra Concluída";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ProjetoES</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/sucesso.css" />
</head>
<body>

    @await Html.PartialAsync("_Header")

    <div class="receipt-card">
        <div class="success-icon">
            <i class="fas fa-check"></i>
        </div>

        <h1>Pagamento Confirmado!</h1>
        <p>Obrigado, John Jones. O teu acesso aos filmes já está disponível na tua área pessoal.</p>

        <div class="order-summary-box">
            <span class="order-id">Pedido #ES-2026-9482</span>
            
            <div class="receipt-item">
                <span>1x Festival da Batata Doce (Bilhete)</span>
                <span>15.00€</span>
            </div>
            <div class="receipt-item">
                <span>1x Festival do Caroço (Passe)</span>
                <span>40.00€</span>
            </div>
            <div class="receipt-item">
                <span>1x Batman: O Início (Aluguer)</span>
                <span>4.50€</span>
            </div>

            <div class="receipt-total">
                <span>Total Pago</span>
                <span>59.50€</span>
            </div>
        </div>

        <div class="action-buttons">
            <button class="btn-download">
                <i class="fas fa-file-pdf"></i> Descarregar Recibo PDF
            </button>
            <a href="/Perfil" class="btn-secondary">Ir para os Meus Acessos</a>
            <a href="/" class="btn-secondary" style="border:none;">Voltar à Página Inicial</a>
        </div>
    </div>

</body>
</html>