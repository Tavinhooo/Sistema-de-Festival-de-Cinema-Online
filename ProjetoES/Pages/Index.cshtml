@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

<div class="main-content">
    <section>
        <h2 class="section-title">Festivais a decorrer...</h2>
        <div class="card-row">
            @for (int i = 0; i < 5; i++)
            {
                <div class="card">
                    <div class="shapes-placeholder">
                        <div style="width: 100%; display:flex; justify-content:center;">
                            <div class="shape-triangle"></div>
                        </div>
                        <div class="shape shape-star"></div>
                        <div class="shape shape-square"></div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section>
        <h2 class="section-title">Próximos Festivais</h2>
        <div class="card-row">
            @for (int i = 0; i < 5; i++)
            {
                <div class="card">
                    <div class="shapes-placeholder">
                        <div style="width: 100%; display:flex; justify-content:center;">
                            <div class="shape-triangle"></div>
                        </div>
                        <div class="shape shape-star"></div>
                        <div class="shape shape-square"></div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>