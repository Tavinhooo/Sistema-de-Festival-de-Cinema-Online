@page
@model IndexModel
@{
    ViewData["Title"] = "Página Inicial";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-PT">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/filmes.css" />
</head>

<body>

    <header class="navbar">
        <a asp-page="/Index" class="logo" aria-label="Ir para a página inicial">
            <img src="~/images/logo.png" alt="Logo do festival" style="width: 200px; height: 77px; object-fit: contain; display: block;" />
        </a>
        
        <div class="search-container">
            <input type="text" placeholder="Pesquisa Geral">
            <i class="fas fa-search"></i>
        </div>

        <div class="nav-actions" id="navActions">
            <a asp-page="/Carrinho" class="cart-link" aria-label="Abrir carrinho">
                <i class="fas fa-shopping-cart cart-icon"></i>
            </a>
            <a class="btn btn-signin" asp-page="/Login">Sign in</a>
            <a class="btn btn-register" asp-page="/Register">Register</a>
        </div>
    </header>

    <main class="main-content">
        
        <section>
            <h2 class="section-title">Festivais a decorrer...</h2>
            <div class="card-row" id="current-festivals">
                <!-- skeletons to avoid flash of unrelated server content -->
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
            </div>
        </section>

        <section>
            <h2 class="section-title">Próximos Festivais</h2>
            <div class="card-row" id="upcoming-festivals">
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
            </div>
        </section>

    </main>

</body>
<script src="~/js/api-client.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        ApiClient.renderAuthNavigation('#navActions');
    });

    async function renderFestivais() {
        const currentContainer = document.getElementById('current-festivals');
        const upcomingContainer = document.getElementById('upcoming-festivals');

        try {
            const [ongoing, upcoming] = await Promise.all([
                ApiClient.getFestivaisADecorrer(),
                ApiClient.getFestivaisProximos()
            ]);

            function createCard(f) {
                const div = document.createElement('div');
                div.className = 'card';
                div.style.cursor = 'pointer';
                div.title = f.nome || f.nomeFestival || 'Ver filmes deste festival';

                const title = document.createElement('h3');
                title.textContent = f.nome || f.nomeFestival || 'Festival';
                const dates = document.createElement('p');
                const d1 = new Date(f.dataInicio).toLocaleDateString();
                const d2 = new Date(f.dataFim).toLocaleDateString();
                dates.textContent = `${d1} — ${d2}`;

                div.appendChild(title);
                div.appendChild(dates);

                // Redirect to Filmes page with festivalId query parameter
                const festivalId = f.id ?? f.Id ?? f.festivalId ?? f.idFestival;
                if (festivalId) {
                    div.addEventListener('click', () => {
                        window.location.href = `/Filmes?festivalId=${festivalId}`;
                    });
                }

                return div;
            }

            currentContainer.innerHTML = '';
            ongoing.forEach(f => currentContainer.appendChild(createCard(f)));

            upcomingContainer.innerHTML = '';
            upcoming.forEach(f => upcomingContainer.appendChild(createCard(f)));
        } catch (err) {
            console.error('Falha ao carregar festivais', err);
        }
    }

    document.addEventListener('DOMContentLoaded', renderFestivais);
</script>

</html>

</html>