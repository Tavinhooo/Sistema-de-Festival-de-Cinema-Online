@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

<div class="main-content">
    <section>
        <h2 class="section-title">Festivais a decorrer...</h2>
        <div class="card-row">
            @if (!Model.ListaFestivais.Any())
            {
                <p style="padding: 20px; color: #666; font-style: italic;">
                    Não foram encontrados festivais ativos de momento.
                </p>
            }
            else
            {
                @foreach (var festival in Model.ListaFestivais)
                {
                    <a href="/Filmes?festivalId=@festival.Id" class="card" style="text-decoration: none; color: inherit;">
                        <div class="shapes-placeholder" style="width: 100% !important; height: 100% !important; padding: 0; overflow: hidden; position: relative;">
                            
                            <img src="@festival.PosterUrl" 
                                 style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" 
                                 onerror="this.src='/images/default-festival.jpg';" />

                            <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.9)); padding: 20px 10px 10px 10px; color: white; text-align: center;">
                                <strong style="display: block; font-size: 16px; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">@festival.Nome</strong>
                                <span style="font-size: 11px; opacity: 0.9;">
                                    @festival.DataInicio.ToString("dd MMM") - @festival.DataFim.ToString("dd MMM yyyy")
                                </span>
                            </div>
                        </div>
                    </a>
                }
            }
        </div>
    </section>

    <section>
        <h2 class="section-title">Próximos Festivais</h2>
        <div class="card-row">
             <p style="padding: 20px; color: #bbb; font-size: 14px;">Fica atento a novas datas...</p>
        </div>
    </section>
</div>