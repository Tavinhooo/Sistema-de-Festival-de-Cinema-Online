@page
@model RegisterModel
@{
    ViewData["Title"] = "Registe-se";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoES</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/register.css" />
</head>
<body>

    <div class="login-page-wrapper">
        
        <div class="form-section">
            <div class="form-wrapper">
                
                <h1>Registe-se</h1>

                <form method="post">
                    
                    <div asp-validation-summary="ModelOnly" style="color: #e53935; font-size: 13px; margin-bottom: 15px; font-weight: 600;"></div>

                    <div class="name-row">
                        <div class="input-group">
                            <div class="label-row">
                                <label asp-for="Input.Nome">Primeiro Nome</label>
                            </div>
                            <input asp-for="Input.Nome" placeholder="Nome" required>
                            <span asp-validation-for="Input.Nome" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                        </div>

                        <div class="input-group">
                            <div class="label-row">
                                <label asp-for="Input.Apelido">Último Nome</label>
                            </div>
                            <input asp-for="Input.Apelido" placeholder="Apelido" required>
                            <span asp-validation-for="Input.Apelido" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                        </div>
                    </div>

                    <div class="input-group">
                        <div class="label-row">
                            <label asp-for="Input.Email">Email</label>
                        </div>
                        <input asp-for="Input.Email" placeholder="Escreva o seu email" required>
                        <span asp-validation-for="Input.Email" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                    </div>

                    <div class="input-group">
                        <div class="label-row">
                            <label asp-for="Input.Password">Password</label>
                        </div>
                        <input asp-for="Input.Password" type="password" placeholder="Password" required>
                        <span asp-validation-for="Input.Password" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                    </div>

                    <div class="input-group">
                        <div class="label-row">
                            <label asp-for="Input.ConfirmarPassword">Confirmar Password</label>
                        </div>
                        <input asp-for="Input.ConfirmarPassword" type="password" placeholder="Repita a password" required>
                        <span asp-validation-for="Input.ConfirmarPassword" style="color: #e53935; font-size: 11px; margin-top: 5px;"></span>
                    </div>

                    <div class="checkbox-row">
                        <input type="checkbox" id="terms" name="terms" required>
                        <label for="terms">Eu concordo com os termos e condições.</label>
                    </div>

                    <button type="submit" class="btn-login">Criar</button>

                </form>

<div class="google-btn-wrapper">
    <form method="post" asp-page-handler="GoogleLogin">
        <button type="submit" class="btn-google">
            <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Sign in with Google
        </button>
    </form>
</div>

                <p class="register-link">
                    Já tem conta? <a href="/Login">Conecte-se</a>
                </p>

            </div>
        </div>

        <div class="image-section">
            <svg class="svg-waves" viewBox="0 0 600 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
                        <feDropShadow dx="-12" dy="5" stdDeviation="10" flood-color="#000000" flood-opacity="0.15"/>
                    </filter>
                </defs>
                <rect width="100%" height="100%" fill="#d2bdf5" />
                <path d="M 250,0 C 350,300 150,600 350,1000 L 600,1000 L 600,0 Z" fill="#bca1ef" filter="url(#shadow)" />
                <path d="M 350,0 C 200,250 450,700 450,1000 L 600,1000 L 600,0 Z" fill="#cfb6f6" filter="url(#shadow)" />
                <path d="M 500,0 C 400,350 600,650 550,1000 L 600,1000 L 600,0 Z" fill="#e5d8fb" filter="url(#shadow)" />
            </svg>
        </div>

    </div>

</body>
</html>